rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Secure user-scoped data: Only the authenticated owner can access their datasets
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Match all subcollections (products, clients, invoices, quotations, etc.)
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
